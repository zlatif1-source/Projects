#include "art.h"
#include <iostream>
using namespace std;

class Tester{
public:
  // the following tests the normal case of create() function
  bool testCreateNormal();
  bool testConstructorError();
  bool testCopyConstructorNormal();
  bool testAssignmentNormal();
  bool testLeft2RightSelf();


private:
  /******************************************
   * Test function declarations go here! *
   ******************************************/
  bool checkRange(const Art& art, int min, int max);
};



bool Tester::testCreateNormal(){
  Art a(5, 5);
  a.create(10);

  if (a.m_painting == nullptr)
    return false;

  return checkRange(a, 10, 99);
}
bool Tester::testConstructorError(){
  Art a(-5, -10);
  return (a.m_height == 0 && a.m_width == 0 && a.m_painting == nullptr);
  



}
bool Tester::testCopyConstructorNormal(){
  Art a(3, 3);
  a.create(7);

  Art b(a);

  if (a.m_painting == b.m_painting)
    return false; //shallow check


  for (int i = 0; i < a.m_height; i++) {
    for (int j = 0; j < a.m_width; j++) {
      if (a.m_painting[i][j] != b.m_painting[i][j])
	return false;
    }
  }
  return true;
}



  

