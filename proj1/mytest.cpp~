//RANDOM CLASS (FROM driver.cpp)
enum RANDOM {UNIFORMINT, UNIFORMREAL, NORMAL};

class Random {
public:
  Random(int min, int max, RANDOM type=UNIFORMINT, int mean=50, int stdev=20)
    : m_min(min), m_max(max), m_type(type)
  {
    if (type == NORMAL){
      m_generator = std::mt19937(m_device());
      m_normdist = std::normal_distribution<>(mean,stdev);
    }
    else if (type == UNIFORMINT) {
      m_generator = std::mt19937(10);
      m_unidist = std::uniform_int_distribution<>(min,max);
    }
    else{
      m_generator = std::mt19937(10);
      m_uniReal = std::uniform_real_distribution<double>((double)min,(double)max);
    }
  }

  int getRandNum(){
    int result = 0;
    if(m_type == NORMAL){
      result = m_min - 1;
      while(result < m_min || result > m_max)
	result = m_normdist(m_generator);
    }
    else if (m_type == UNIFORMINT){
      result = m_unidist(m_generator);
    }
    return result;
  }

private:
  int m_min;
  int m_max;
  RANDOM m_type;
  std::random_device m_device;
  std::mt19937 m_generator;
  std::normal_distribution<> m_normdist;
  std::uniform_int_distribution<> m_unidist;
  std::uniform_real_distribution<double> m_uniReal;
};

//TESTER CLASS 
class Tester {
public:
  bool testAddTankNormal();
  bool testAddTankError();
  bool testRemoveTankNormal();
  bool testRemoveTankError();
  bool testFindTankNormal();
  bool testFindTankError();
  bool testTotalFuelNormal();
  bool testTotalFuelEmpty();
  bool testAddPumpNormal();
  bool testAddPumpError();
  bool testRemovePumpNormal();
  bool testRemovePumpError();
  bool testDrainNormal();
  bool testDrainError();
  bool testAssignmentOperator();
};

//TEST IMPLEMENTATIONS

bool Tester::testAddTankNormal(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  
  int total = 0;
  for(int i=1;i<=5;i++){
    int fuel = randFuel.getRandNum();
    total += fuel;
    if(!sys.addTank(i, DEFCAP, fuel))
      return false;
  }
  return sys.totalFuel() == total;
}

bool Tester::testAddTankError(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  
  sys.addTank(1, DEFCAP, randFuel.getRandNum());
  return !sys.addTank(1, DEFCAP, randFuel.getRandNum()) &&
    !sys.addTank(-1, DEFCAP, randFuel.getRandNum());
}

bool Tester::testRemoveTankNormal(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  
  for(int i=1;i<=5;i++)
    sys.addTank(i, DEFCAP, randFuel.getRandNum());
  
  for(int i=1;i<=5;i++){
    if(!sys.removeTank(i))
      return false;
  }
  return sys.totalFuel() == 0;
}

bool Tester::testRemoveTankError(){
  FuelSys sys;
  return !sys.removeTank(99);
}

bool Tester::testFindTankNormal(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  
  for(int i=1;i<=5;i++)
    sys.addTank(i, DEFCAP, randFuel.getRandNum());
  
  return sys.findTank(3);
}

bool Tester::testFindTankError(){
  FuelSys sys;
  return !sys.findTank(50);
}

bool Tester::testTotalFuelNormal(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  
  int sum = 0;
  for(int i=1;i<=3;i++){
    int fuel = randFuel.getRandNum();
    sum += fuel;
    sys.addTank(i, DEFCAP, fuel);
  }
  return sys.totalFuel() == sum;
}

bool Tester::testTotalFuelEmpty(){
  FuelSys sys;
  return sys.totalFuel() == 0;
}

bool Tester::testAddPumpNormal(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  Random randTarget(1,3);
  
  for(int i=1;i<=3;i++)
    sys.addTank(i, DEFCAP, randFuel.getRandNum());
  
  return sys.addPump(1, 10, randTarget.getRandNum());
}

bool Tester::testAddPumpError(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  
  sys.addTank(1, DEFCAP, randFuel.getRandNum());
  sys.addTank(2, DEFCAP, randFuel.getRandNum());
  sys.addPump(1, 5, 2);
  
  return !sys.addPump(1, 5, 2) &&
    !sys.addPump(9, 1, 2);
}

bool Tester::testRemovePumpNormal(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  
  sys.addTank(1, DEFCAP, randFuel.getRandNum());
  sys.addTank(2, DEFCAP, randFuel.getRandNum());
  sys.addPump(1, 7, 2);
  
  return sys.removePump(1,7);
}

bool Tester::testRemovePumpError(){
  FuelSys sys;
  return !sys.removePump(1,1);
}

bool Tester::testDrainNormal(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);

  sys.addTank(1, DEFCAP, DEFCAP);
  sys.addTank(2, DEFCAP, randFuel.getRandNum());
  sys.addPump(1, 1, 2);

  int before = sys.totalFuel();
  sys.drain(1,1,MINCAP);
  
  return sys.totalFuel() == before;
}

bool Tester::testDrainError(){
  FuelSys sys;
  return !sys.drain(1,1,100);
}

bool Tester::testAssignmentOperator(){
  FuelSys sys;
  Random randFuel(MINCAP, DEFCAP);
  
  for(int i=1;i<=3;i++)
    sys.addTank(i, DEFCAP, randFuel.getRandNum());
  
  sys.addPump(1,1,2);
  
  FuelSys copy;
  copy = sys;
  
  return copy.totalFuel() == sys.totalFuel();
}

