#include "vdetect.h"

VDetect::VDetect(int size, hash_fn hash, prob_t probing){
  
  int cap = size;
  
  if (cap <= MINPRIME){
    cap = MINPRIME;
  }
  else if (cap >= MAXPRIME){
    cap = MAXPRIME;
  }
  else if (!isPrime(cap)){
    cap = findNextPrime(cap);
  }
  
  m_hash = hash;
  m_newPolicy = probing;
  
  m_currentTable = new Virus*[cap];
  m_currentCap = cap;
  m_currentSize = 0;
  m_currNumDeleted = 0;
  m_currProbing = probing;
  
  for (int i = 0; i < m_currentCap; i++){
    m_currentTable[i] = nullptr;
  }
  
  m_oldTable = nullptr;
  m_oldCap = 0;
  m_oldSize = 0;
  m_oldNumDeleted = 0;
  m_oldProbing = probing;
  
  m_transferIndex = 0;
}

VDetect::~VDetect(){
  
  clearTable(m_currentTable, m_currentCap);
  clearTable(m_oldTable, m_oldCap);
  
  m_currentTable = nullptr;
  m_oldTable = nullptr;
}

void VDetect::changeProbPolicy(prob_t policy){
  
  m_newPolicy = policy;
}

bool VDetect::insert(Virus virus){
  
  if (virus.getID() < MINID || virus.getID() > MAXID){
    return false;
  }
  
  if (getVirus(virus.getKey(), virus.getID()) == virus){
    return false;
  }
  
  virus.setUsed(true);
  
  bool result = insertIntoTable(m_currentTable, m_currentCap, m_currProbing, virus, m_currentSize, m_currNumDeleted);
  
  if (result){
    if (m_oldTable != nullptr){
      transferOldTable();
    }
    
    if (m_oldTable == nullptr){
      if (lambda() > 0.5 || deletedRatio() > 0.8){
	startRehash();
	transferOldTable();
      }
    }
  }
  
  return result;
}

bool VDetect::remove(Virus virus){

  int index = findIndex(m_currentTable, m_currentCap, m_currProbing, virus.getKey(), virus.getID());
  
  if (index != -1){
    m_currentTable[index]->setUsed(false);
    m_currNumDeleted++;
    
    if (m_oldTable != nullptr){
      transferOldTable();
    }
    
    if (m_oldTable == nullptr){
      if (deletedRatio() > 0.8){
	startRehash();
	transferOldTable();
      }
    }
    
    return true;
  }
  
  index = findIndex(m_oldTable, m_oldCap, m_oldProbing, virus.getKey(), virus.getID());
  
  if (index != -1){
    m_oldTable[index]->setUsed(false);
    m_oldNumDeleted++;
    
    if (m_oldTable != nullptr){
      transferOldTable();
    }
    
    return true;
  }
  
  return false;
}

const Virus VDetect::getVirus(string sequence, int id) const{
  
  int index = findIndex(m_currentTable, m_currentCap, m_currProbing, sequence, id);
  
  if (index != -1){
    return *(m_currentTable[index]);
  }
  
  index = findIndex(m_oldTable, m_oldCap, m_oldProbing, sequence, id);
  
  if (index != -1){
    return *(m_oldTable[index]);
  }
  
  return EMPTY;
}

bool VDetect::updateID(Virus virus, int id){
  
  if (id < MINID || id > MAXID){
    return false;
  }
  
  if (id != virus.getID()){
    Virus duplicate = getVirus(virus.getKey(), id);
    
    if (!(duplicate == EMPTY)){
      return false;
    }
  }
  
  int index = findIndex(m_currentTable, m_currentCap, m_currProbing, virus.getKey(),virus.getID());
  
  if (index != -1){
    m_currentTable[index]->setID(id);
    return true;
  }
  
  index = findIndex(m_oldTable, m_oldCap, m_oldProbing, virus.getKey(), virus.getID());
  
  if (index != -1){
    m_oldTable[index]->setID(id);
    return true;
  }
  
  return false;
}

float VDetect::lambda() const {
  
  if (m_currentCap == 0){
    return 0.0;
  }
  
  return (float)m_currentSize / (float)m_currentCap;
}

float VDetect::deletedRatio() const {
  
  if (m_currentSize == 0){
    return 0.0;
  }
  
  return (float)m_currNumDeleted / (float)m_currentSize;
}

void VDetect::dump() const {
  cout << "Dump for the current table: " << endl;
  if (m_currentTable != nullptr)
    for (int i = 0; i < m_currentCap; i++) {
      cout << "[" << i << "] : " << m_currentTable[i] << endl;
    }
  cout << "Dump for the old table: " << endl;
  if (m_oldTable != nullptr)
    for (int i = 0; i < m_oldCap; i++) {
      cout << "[" << i << "] : " << m_oldTable[i] << endl;
    }
}

bool VDetect::isPrime(int number){

  bool result = true;
  
  if (number < 2){
    result = false;
  }
  
  for (int i = 2; i <= number / 2; ++i) {
    if (number % i == 0) {
      result = false;
      break;
    }
  }
  
  return result;
}

int VDetect::findNextPrime(int current){
  
  if (current <= MINPRIME){
    return MINPRIME;
  }
  
  if (current >= MAXPRIME){
    return MAXPRIME;
  }
  
  int num = current + 1;
  
  while (num < MAXPRIME){
    if (isPrime(num)){
      return num;
    }
    
    num++;
  }
  
  return MAXPRIME;
}

int VDetect::probeIndex(string key, int i, int cap, prob_t policy) const{
  
  unsigned int hashValue = m_hash(key);
  int home = hashValue % cap;
  int index = home;
  
  if (policy == LINEAR){
    index = (home + i) % cap;
  }
  else if (policy == QUADRATIC){
    index = (home + (i * i)) % cap;
  }
  else if (policy == DOUBLEHASH){
    int step = 11 - (hashValue % 11);
    index = (home + (i * step)) % cap;
  }
  
  return index;
}

int VDetect::findIndex(Virus** table, int cap, prob_t policy,
                       string key, int id) const{
  
  if (table == nullptr || cap == 0){
    return -1;
  }
  
  for (int i = 0; i < cap; i++){
    int index = probeIndex(key, i, cap, policy);
    
    if (table[index] == nullptr){
      return -1;
    }
    
    if (table[index]->getKey() == key &&
	table[index]->getID() == id &&
	table[index]->getUsed() == true){
      return index;
    }
  }
  
  return -1;
}

bool VDetect::insertIntoTable(Virus** table, int cap, prob_t policy,
                              Virus virus, int& tableSize, int& numDeleted){
  
  if (table == nullptr || cap == 0){
    return false;
  }
  
  int deletedIndex = -1;
  
  for (int i = 0; i < cap; i++){
    int index = probeIndex(virus.getKey(), i, cap, policy);
    
    if (table[index] == nullptr){
      if (deletedIndex != -1){
	table[deletedIndex]->setKey(virus.getKey());
	table[deletedIndex]->setID(virus.getID());
	table[deletedIndex]->setUsed(true);
	numDeleted--;
      }
      else{
	table[index] = new Virus(virus.getKey(), virus.getID(), true);
	tableSize++;
      }
      
      return true;
    }
    
    if (table[index]->getUsed() == false && deletedIndex == -1){
      deletedIndex = index;
    }
  }
  
  if (deletedIndex != -1){
    table[deletedIndex]->setKey(virus.getKey());
    table[deletedIndex]->setID(virus.getID());
    table[deletedIndex]->setUsed(true);
    numDeleted--;
    return true;
  }
  
  return false;
}

void VDetect::startRehash(){
  
  if (m_oldTable != nullptr){
    return;
  }
  
  int liveData = m_currentSize - m_currNumDeleted;
  int newCap = findNextPrime(liveData * 4);
  
  m_oldTable = m_currentTable;
  m_oldCap = m_currentCap;
  m_oldSize = m_currentSize;
  m_oldNumDeleted = m_currNumDeleted;
  m_oldProbing = m_currProbing;
  
  m_currentTable = new Virus*[newCap];
  m_currentCap = newCap;
  m_currentSize = 0;
  m_currNumDeleted = 0;
  m_currProbing = m_newPolicy;
  
  for (int i = 0; i < m_currentCap; i++){
    m_currentTable[i] = nullptr;
  }
  
  m_transferIndex = 0;
}

void VDetect::transferOldTable(){

  if (m_oldTable == nullptr){
    return;
  }
  
  int amount = m_oldCap / 4;
  
  if (amount < 1){
    amount = 1;
  }
  
  int stop = m_transferIndex + amount;
  
  if (stop > m_oldCap){
    stop = m_oldCap;
  }
  
  for (int i = m_transferIndex; i < stop; i++){
    if (m_oldTable[i] != nullptr){
      if (m_oldTable[i]->getUsed() == true){
	insertIntoTable(m_currentTable, m_currentCap, m_currProbing, *(m_oldTable[i]), m_currentSize, m_currNumDeleted);
      }
      
      delete m_oldTable[i];
      m_oldTable[i] = nullptr;
    }
  }
  
  m_transferIndex = stop;
  
  if (m_transferIndex >= m_oldCap){
    delete [] m_oldTable;
    
    m_oldTable = nullptr;
    m_oldCap = 0;
    m_oldSize = 0;
    m_oldNumDeleted = 0;
    m_transferIndex = 0;
  }
}

void VDetect::clearTable(Virus** table, int cap){
  
  if (table != nullptr){
    for (int i = 0; i < cap; i++){
      if (table[i] != nullptr){
	delete table[i];
	table[i] = nullptr;
      }
    }
    
    delete [] table;
  }
}

int VDetect::nextPrimeGap(int current){

  int next = findNextPrime(current);
  return next - current;
}
