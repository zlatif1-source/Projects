#include "fuel.h"


//constructor
FuelSys::FuelSys() {
  m_current = nullptr;
}


//destructor
FuelSys::~FuelSys() {
  if (m_current == nullptr) return;

  Tank* start = m_current;
  Tank* curr = m_current->m_next;

  while (curr != start) {
    Tank* delTank = curr;
    curr = curr->m_next;

    Pump* p = delTank->m_pumps;
    while (p != nullptr) {
      Pump* delP = p;
      p = p->m_next;
            delete delP;
    }
    delete delTank;
  }

  // delete last tank
  Pump* p = start->m_pumps;
  while (p != nullptr) {
        Pump* delP = p;
        p = p->m_next;
        delete delP;
  }
  delete start;
  
    m_current = nullptr;
}


//addTank
bool FuelSys::addTank(int tankID, int tankCap, int tankFuel) {
  if (tankID < 0 || tankCap < MINCAP || tankFuel < 0 || tankFuel > tankCap)
    return false;

  if (findTank(tankID))
    return false;
  
  Tank* newTank = new Tank(tankID, tankCap, tankFuel);
  
  if (m_current == nullptr) {
    newTank->m_next = newTank;
    m_current = newTank;
  } else {
    newTank->m_next = m_current->m_next;
    m_current->m_next = newTank;
    m_current = newTank;
  }
  return true;
}


//removeTank
bool FuelSys::removeTank(int tankID) {
  if (m_current == nullptr) return false;
  
  Tank* prev = m_current;
  Tank* curr = m_current->m_next;

  do {
    if (curr->m_tankID == tankID) {
      prev->m_next = curr->m_next;

      if (curr == m_current) {
	m_current = (curr->m_next == curr) ? nullptr : prev;
      }

      Pump* p = curr->m_pumps;
      while (p != nullptr) {
	Pump* del = p;
	p = p->m_next;
	delete del;
      }

      delete curr;
      return true;
    }
    prev = curr;
    curr = curr->m_next;
  } while (prev != m_current);
  
  return false;
}


//findTank
//makes found tank the NEXT of current
bool FuelSys::findTank(int tankID) {
  if (m_current == nullptr) return false;
  
  Tank* prev = m_current;
  Tank* curr = m_current->m_next;
  
  do {
    if (curr->m_tankID == tankID) {
      m_current = prev;
      return true;
    }
    prev = curr;
    curr = curr->m_next;
  } while (prev != m_current);

  return false;
}


//addPump

bool FuelSys::addPump(int tankID, int pumpID, int targetTank) {
  if (m_current == nullptr) return false;
  
  Tank* saved = m_current;
  
  if (!findTank(tankID)) {
    m_current = saved;
    return false;
  }
  
  Tank* source = m_current->m_next;
  
  Pump* p = source->m_pumps;
  while (p != nullptr) {
    if (p->m_pumpID == pumpID) {
      m_current = saved;
      return false;
    }
    p = p->m_next;
  }

  if (!findTank(targetTank)) {
    m_current = saved;
    return false;
  }
  
  Pump* newPump = new Pump(pumpID, targetTank, source->m_pumps);
  source->m_pumps = newPump;

  m_current = saved;
  return true;
}


//removePump
bool FuelSys::removePump(int tankID, int pumpID) {
  if (!findTank(tankID)) return false;

  Tank* tank = m_current->m_next;
  Pump* curr = tank->m_pumps;
  Pump* prev = nullptr;

  while (curr != nullptr) {
    if (curr->m_pumpID == pumpID) {
      if (prev == nullptr)
	tank->m_pumps = curr->m_next;
      else
	prev->m_next = curr->m_next;
      
      delete curr;
      return true;
    }
    prev = curr;
    curr = curr->m_next;
  }
  return false;
}


//fill 
bool FuelSys::fill(int tankID, int fuel) {
  if (fuel <= 0 || !findTank(tankID))
    return false;
  
    Tank* tank = m_current->m_next;
    int space = tank->m_tankCapacity - tank->m_tankFuel;
    
    if (fuel >= space)
      tank->m_tankFuel = tank->m_tankCapacity;
    else
      tank->m_tankFuel += fuel;

    return true;
}

//totalFuel
int FuelSys::totalFuel() const {
  if (m_current == nullptr)
    return 0;
  
  int total = 0;
  Tank* curr = m_current->m_next;
  
  do {
    total += curr->m_tankFuel;
    curr = curr->m_next;
  } while (curr != m_current->m_next);
  
  return total;
}


//drain 
bool FuelSys::drain(int tankID, int pumpID, int fuel) {
  if (fuel <= 0 || !findTank(tankID)) //if empty
    return false;
  
  Tank* source = m_current->m_next;
  
  Pump* p = source->m_pumps;
  while (p != nullptr && p->m_pumpID != pumpID)
    p = p->m_next;
  
  if (p == nullptr) return false;
  
  if (!findTank(p->m_target))
    return false;
  
  Tank* target = m_current->m_next;
  
  int transferable = fuel;
  if (transferable > source->m_tankFuel)
    transferable = source->m_tankFuel;
  
  int space = target->m_tankCapacity - target->m_tankFuel;
  if (transferable > space)
    transferable = space;
  
  source->m_tankFuel -= transferable;
  target->m_tankFuel += transferable;
  
  return true;
}


//assignment Operator
const FuelSys & FuelSys::operator=(const FuelSys & rhs) {
  if (this == &rhs)
    return *this;
  
  this->~FuelSys();
  m_current = nullptr;
  
  if (rhs.m_current == nullptr)
    return *this;
  
  Tank* curr = rhs.m_current->m_next;
  
  do {
    addTank(curr->m_tankID, curr->m_tankCapacity, curr->m_tankFuel);
    
    Pump* p = curr->m_pumps;
    while (p != nullptr) {
      addPump(curr->m_tankID, p->m_pumpID, p->m_target);
      p = p->m_next;
    }
    
    curr = curr->m_next;
  } while (curr != rhs.m_current->m_next);
  
  findTank(rhs.m_current->m_next->m_tankID);
  return *this;
}


void FuelSys::dumpSys() const{
  if (m_current != nullptr){
    Tank* tempTank = m_current->m_next;//we start at front item
    //we continue visting nodes until we reach the cursor
    while(m_current != nullptr && tempTank != m_current){
      cout << "Tank " << tempTank->m_tankID << "(" << tempTank->m_tankFuel << " kg)" << endl;
      // now dump the targets for all pumps in this tank
      // we need to traverse the list of pumps
      dumpPumps(tempTank->m_pumps);
      tempTank = tempTank->m_next;
    }
    //at the end we visit the cursor (current)
    //this also covers the case that there is only one item
    cout << "Tank " << m_current->m_tankID << "(" << m_current->m_tankFuel << " kg)" << endl;
    dumpPumps(tempTank->m_pumps);
    cout << "The current tank is " << m_current->m_tankID << endl;
  }
  else
    cout << "There is no tank in the system!\n\n";
}

void FuelSys::dumpPumps(Pump* pumps) const{
  // this traverses the linked list to the end
  Pump* tempPump = pumps;
  while (tempPump != nullptr){
    cout << " => pump " << tempPump->m_pumpID << "(To tank " << tempPump->m_target << ")" << endl;
    tempPump = tempPump->m_next;
  }
}
