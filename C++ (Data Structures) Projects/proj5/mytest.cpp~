bool Tester::testAssignmentNormal(){
  Graph original("testdata.txt");
  Graph copy;
  
  copy = original;
  
  if (copy.empty()){
    return false;
  }
  
  if (copy.m_numNodes != original.m_numNodes){
    return false;
  }
  
  Node *originalNode0 = original.findNode(0);
  Node *copyNode0 = copy.findNode(0);
  
  if (originalNode0 == nullptr || copyNode0 == nullptr){
    return false;
  }
  
  if (originalNode0 == copyNode0){
    return false;
  }
  
  if (originalNode0->getValue() != copyNode0->getValue()){
    return false;
  }
  
  if (originalNode0->getSouth() == nullptr || copyNode0->getSouth() == nullptr){
    return false;
  }
  
  if (originalNode0->getSouth() == copyNode0->getSouth()){
    return false;
  }
  
  if (originalNode0->getSouth()->getValue() != copyNode0->getSouth()->getValue()){
    return false;
  }
  
  if (!copy.findPath(0, 15)){
    return false;
  }
  
  original.clearGraph();
  
  if (!original.empty()){
    return false;
  }
  
  if (copy.empty()){
    return false;
  }
  
  if (!copy.findPath(0, 15)){
    return false;
  }
  
  return true;
}

