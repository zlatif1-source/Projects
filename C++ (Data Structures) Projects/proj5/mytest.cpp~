bool Tester::testPathExists(){
  Graph graph("testdata.txt");
  
  if (graph.empty()){
    return false;
  }
  
  bool result = graph.findPath(0, 15);
  
  if (!result){
    return false;
  }
  
  if (graph.m_path.empty()){
    return false;
  }
  
  int expectedPath[9] = {0, 4, 5, 1, 2, 6, 7, 11, 15};
  stack<int> tempPath = graph.m_path;
  
  for (int i = 0; i < 9; i++){
    if (tempPath.empty()){
      return false;
    }
    
    if (tempPath.top() != expectedPath[i]){
      return false;
    }
    
    tempPath.pop();
  }
  
  if (!tempPath.empty()){
    return false;
  }
  
  return true;
}


